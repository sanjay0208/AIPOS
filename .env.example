# ===================================
# AIPOS Environment Variables
# ===================================

APP_NAME=AIPOS
APP_ENV=development
APP_PORT=8000

# Database
POSTGRES_DB=aipos
POSTGRES_USER=aipos
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me

# JWT
JWT_SECRET=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60